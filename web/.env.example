# Copiá a .env.local y completá. Todo es opcional: sin estas variables la app funciona con datos de demo.

# --- Mercado Pago ---
# Token de acceso fijo (usuario de prueba o cuenta propia). Se usa si el usuario no conectó su cuenta por OAuth.
MP_ACCESS_TOKEN=
# api | simulacion | mixto. Sin definir: con token mezcla API + historia simulada; sin token, solo simulación.
MP_MODO=

# --- Mercado Pago OAuth (conectar la cuenta del usuario: /api/mp/auth -> /api/mp/callback) ---
# Los cuatro son necesarios; si falta alguno las rutas /api/mp/auth y /callback responden 501 con la lista de faltantes.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Debe coincidir con la URL registrada en la app de MP, p. ej. https://tu-dominio/api/mp/callback
MP_REDIRECT_URI=
# Secreto para cifrar la cookie con el access_token (AES-256-GCM). Generá uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MP_COOKIE_SECRET=
